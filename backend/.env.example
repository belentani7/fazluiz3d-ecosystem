# Modo local-first: no necesitas rellenar ninguna variable para guardar pedidos y leads.
# El backend escribe en backend/data/database.json.

# Integraciones opcionales; deja vacías para usar los fallbacks locales.
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=

# No se requiere Supabase en esta versión standalone.

# Admin mail relay is OFF unless all 3 values below are configured.
# Generate AUREA_ADMIN_TOKEN securely (at least 32 random characters).
# Never expose this token in NEXT_PUBLIC_* or a browser bundle.
AUREA_ADMIN_TOKEN=
RESEND_FROM_EMAIL=

# Public contact endpoint (web-react) only delivers when configured.
# Use a verified sender domain at your mail provider and a real recipient.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
