# Required on web-react deployment for the contact form to deliver real email.
# Never prefix these keys with NEXT_PUBLIC_. Store them in server-side secrets.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Leave unconfigured to return HTTP 503 with an honest error in the UI.
# Sender must be validated with the email provider. Add abuse throttling before public launch.
